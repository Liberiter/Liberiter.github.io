---
// 일지 낱장 한 장 — /journal/{yyyy-mm-dd}/.
// 본문 조판은 기록 페이지와 같은 공용 .prose (src/styles/prose.css) — 읽는 자리는 한 곳이다.
// 여기가 소유하는 건 판형(68ch)과 낱장 고유 요소(날짜·표식·이전/다음)뿐.
// KaTeX CSS — 짝: src/pages/records/[slug].astro (전역 로드 금지 — 347KB 블로킹 방지)
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Emblem from '../../components/Emblem.astro';
import PageBanner from '../../components/PageBanner.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];
const { entry } = Astro.props;
const { Content } = await render(entry);
const heading = entry.data.title ?? '이 날의 기록';
const metaTitle = entry.data.title ?? `${entry.id}의 일지`;
const weekday = WEEKDAYS[new Date(`${entry.id}T00:00:00`).getDay()];

// 이전/다음 낱장 — 같은 컬렉션 시간순 (id = yyyy-mm-dd라 문자열 정렬 = 시간순)
const leaves = (await getCollection('journal')).sort((a, b) => a.id.localeCompare(b.id));
const leafIdx = leaves.findIndex((l) => l.id === entry.id);
const prevLeaf = leafIdx > 0 ? leaves[leafIdx - 1] : null;
const nextLeaf = leafIdx >= 0 && leafIdx < leaves.length - 1 ? leaves[leafIdx + 1] : null;
---

<Base
  title={`${metaTitle} — 방랑자의 일지`}
  description={`${entry.id}에 남긴 짧은 학습 기록 (TIL).`}
  article={{ published: new Date(`${entry.id}T00:00:00`) }}
>
  <!-- 공용 배너(작은 히어로): 낱장의 머리 — 나침반·날짜는 슬롯으로 -->
  <PageBanner slot="hero" kind="article" eyebrow="Wanderer's Journal" title={heading}>
    <div slot="top" class="pb-compass" aria-hidden="true">
      <Emblem id="wanderers-journal" size={34} />
    </div>
    <p slot="meta" class="pb-date">
      <time datetime={entry.id}>{entry.id} ({weekday})</time>
    </p>
  </PageBanner>

  <!-- 수첩 낱장 한 장 -->
  <article class="leaf" data-animate data-pagefind-body>
    <!-- Pagefind 색인 메타 — 화면에는 보이지 않는다 (제목·출처·날짜·표식) -->
    <div class="pf-meta" aria-hidden="true">
      <p data-pagefind-meta="title">{metaTitle}</p>
      <p data-pagefind-meta="place" data-pagefind-filter="장소">방랑자의 일지</p>
      <p data-pagefind-meta="date">{entry.id}</p>
      {entry.data.tags.map((tag) => <p data-pagefind-filter="표식">{tag}</p>)}
    </div>
    <div class="leaf-body prose">
      <Content />
    </div>
    {
      entry.data.tags.length > 0 && (
        <footer class="leaf-tags">
          {entry.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </footer>
      )
    }
  </article>

  {
    (prevLeaf || nextLeaf) && (
      <nav class="leaf-nav" aria-label="이전/다음 낱장" data-animate>
        <span class="ln-prev">
          {prevLeaf && (
            <a href={`/journal/${prevLeaf.id}/`}>← 이전 낱장 · {prevLeaf.data.title ?? prevLeaf.id}</a>
          )}
        </span>
        <span class="ln-next">
          {nextLeaf && (
            <a href={`/journal/${nextLeaf.id}/`}>다음 낱장 · {nextLeaf.data.title ?? nextLeaf.id} →</a>
          )}
        </span>
      </nav>
    )
  }

  <p class="leaf-back" data-animate>
    <a href="/journal/"><span class="dia" aria-hidden="true">✦</span> 일지 전체 보기</a>
  </p>
</Base>

<script>
  import { initScrollAnimations } from '../../scripts/scroll-animations';
  initScrollAnimations();
</script>

<style>
  /* ═══ 배너 위 고유 요소 — 나침반 심볼 + 날짜 (PageBanner 슬롯) ═══ */
  .pb-compass {
    display: flex;
    justify-content: center;
    color: var(--gold);
    filter: var(--glow);
  }
  .pb-date {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  /* ═══ 수첩 낱장 — 기록 페이지와 같은 판형(68ch) ═══
     박스 없이 바탕 위에 바로 앉는다. 조판은 공용 .prose(src/styles/prose.css)가 소유하고
     여기는 판형과 낱장 고유 요소만 갖는다. */
  .leaf {
    max-width: 68ch;
    margin: 40px auto 0;
  }
  .leaf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 34px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .leaf-tags .tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--viridian-text);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--viridian) 40%, transparent);
    padding: 0 7px;
  }

  /* 이전/다음 낱장 — 간단한 텍스트 링크 */
  .leaf-nav {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    max-width: 68ch;
    margin: 22px auto 0;
    font-family: var(--serif);
    font-size: 13.5px;
  }
  .leaf-nav .ln-next {
    margin-left: auto;
    text-align: right;
  }
  .leaf-nav a {
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .leaf-nav a:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
    text-decoration: none;
  }

  /* 일지 전체 보기 */
  .leaf-back {
    text-align: center;
    margin: 30px 0 0;
  }
  .leaf-back a {
    font-family: var(--serif);
    font-size: 13.5px;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .leaf-back a:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
    text-decoration: none;
  }
  .leaf-back .dia {
    color: var(--gold);
    font-size: 9px;
  }
</style>
